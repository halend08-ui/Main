# Copy to .env and fill in. NEVER commit the filled-in version.
#   cp .env.example .env && $EDITOR .env && set -a && . ./.env && set +a

# ---- Required for real fundamentals -----------------------------------------
# The SEC requires automated clients to identify themselves with a working
# contact address. Requests without one are throttled or blocked, and this is
# their stated policy rather than a suggestion.
INGESTION_CONTACT_EMAIL=you@example.com

# ---- Required for macro data ------------------------------------------------
# Free, issued instantly: https://fredaccount.stlouisfed.org/apikeys
# Without it, policy/inflation/curve readings report "unknown" and sector tilts
# are not applied. Prices and fundamentals still work.
FRED_API_KEY=

# ---- Optional ---------------------------------------------------------------
# Free demo key raises CoinGecko's rate limit from ~10/min to ~30/min:
# https://www.coingecko.com/en/api/pricing  (only needed for crypto)
COINGECKO_API_KEY=

# Overrides the risk-free rate used in every DCF. As a decimal fraction.
# Leave unset to use analysis.risk_free_rate_default from the config.
# RISK_FREE_RATE=0.042
