# Commerce OS environment template. COPY to .env (gitignored). NEVER put real values in this file.
# Production secrets belong in GitHub Environment secrets, not in the repository.

# --- Shopify store / Admin API (custom app or Shopify CLI-managed app) ---
SHOPIFY_STORE_DOMAIN=            # e.g. your-dev-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=      # Admin API access token (never commit)
SHOPIFY_API_VERSION=             # optional override; default comes from config/shopify.json
SHOPIFY_ALLOWED_STORES=          # comma-separated allow-list of store domains writes may target
SHOPIFY_WEBHOOK_SECRET=          # app client secret used to verify webhook HMAC

# --- Theme CLI in CI (Theme Access app password) ---
SHOPIFY_CLI_THEME_TOKEN=
SHOPIFY_FLAG_STORE=

# --- Safety switches ---
COMMERCE_OS_WRITE_MODE=dry-run   # dry-run | live   (live requires store in SHOPIFY_ALLOWED_STORES)
LOG_LEVEL=info

# --- Shopify Dev MCP telemetry opt-out ---
OPT_OUT_INSTRUMENTATION=true

# --- Advertising platforms (added only after owner approval; leave empty) ---
META_ADS_ACCESS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
TIKTOK_ADS_ACCESS_TOKEN=
